rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function safeUserWrite() {
      return !request.resource.data.keys().hasAny(['role', 'admin', 'claims']);
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsSession(sessionId) {
      return signedIn()
        && get(/databases/$(database)/documents/test_sessions/$(sessionId)).data.ownerUid == request.auth.uid;
    }

    function publicDomainRead() {
      return signedIn() && (resource.data.active == true || isAdmin());
    }

    function publicTopicRead(domainId) {
      return signedIn()
        && (
          isAdmin()
          || (
            resource.data.active == true
            && get(/databases/$(database)/documents/domains/$(domainId)).data.active == true
          )
        );
    }

    function publicSubtopicRead(domainId, topicId) {
      return signedIn()
        && (
          isAdmin()
          || (
            resource.data.active == true
            && get(/databases/$(database)/documents/domains/$(domainId)).data.active == true
            && get(/databases/$(database)/documents/domains/$(domainId)/topics/$(topicId)).data.active == true
          )
        );
    }

    function publicQuestionRead() {
      return signedIn() && (resource.data.active == true || isAdmin());
    }

    function validPublicQuestionWrite() {
      return request.resource.data.keys().hasAll([
          'id',
          'domain',
          'topic',
          'subtopic',
          'type',
          'difficulty',
          'text',
          'options',
          'marks',
          'negativeMarks',
          'timeRecommended',
          'tags',
          'active',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'domain',
          'topic',
          'subtopic',
          'type',
          'difficulty',
          'text',
          'options',
          'marks',
          'negativeMarks',
          'timeRecommended',
          'tags',
          'active',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && !request.resource.data.keys().hasAny(['correctAnswer', 'explanation']);
    }

    function validAnswerKeyWrite() {
      return request.resource.data.keys().hasAll([
          'questionId',
          'correctAnswer',
          'explanation',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'questionId',
          'correctAnswer',
          'explanation',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function safeSessionAutosave() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'answers',
        'markedForReview',
        'tabSwitchCount',
        'lastSavedAt',
        'updatedAt'
      ]);
    }

    match /answer_keys/{document=**} {
      allow read: if false;
      allow create, update: if isAdmin() && validAnswerKeyWrite();
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if publicQuestionRead();
      allow create, update: if isAdmin() && validPublicQuestionWrite();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if ownsUserDoc(userId) || isAdmin();
      allow create: if (ownsUserDoc(userId) || isAdmin()) && safeUserWrite();
      allow update: if (ownsUserDoc(userId) || isAdmin()) && safeUserWrite();
      allow delete: if isAdmin();

      match /test_attempts/{attemptId} {
        allow read: if ownsUserDoc(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /domains/{domainId} {
      allow read: if publicDomainRead();
      allow create, update, delete: if isAdmin();

      match /topics/{topicId} {
        allow read: if publicTopicRead(domainId);
        allow create, update, delete: if isAdmin();

        match /subtopics/{subtopicId} {
          allow read: if publicSubtopicRead(domainId, topicId);
          allow create, update, delete: if isAdmin();
        }
      }
    }

    match /test_configs/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /test_sessions/{sessionId} {
      allow read: if ownsExistingDocument() || isAdmin();
      allow create, delete: if false;
      allow update: if ownsExistingDocument()
        && resource.data.status == 'in_progress'
        && safeSessionAutosave();

      match /events/{eventId} {
        allow read: if ownsSession(sessionId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /results/{resultId} {
      allow read: if ownsExistingDocument() || isAdmin();
      allow create, update, delete: if false;
    }

    match /aggregates/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
